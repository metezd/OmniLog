# Keep LF line endings in the repository and in the working tree on every OS,
# so files do not change when moving between Linux, macOS and Windows
* text=auto eol=lf

# Windows-only scripts must keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files are never converted
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.zip binary
