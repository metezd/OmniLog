# Copy this file to .env and adjust the values for your machine
DATABASE_URL=postgresql+psycopg2://omnilog:omnilog@localhost:5432/omnilog

# Required, at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The API documentation (/docs, /redoc, /openapi.json) is off by default. Turn it on for
# development only. Never in production, where it would list every endpoint.
ENABLE_DOCS=true

# Used by pytest only. The test database is created automatically if it is missing.
TEST_DATABASE_URL=postgresql+psycopg2://omnilog:omnilog@localhost:5432/omnilog_test
ACCESS_TOKEN_EXPIRE_MINUTES=90

# Redis (L1 cache and rate limit counters). If Redis is down or this is empty, an in-process cache
# is used. A managed Redis such as Upstash works too, with its TLS address (rediss:// with two s):
#   REDIS_URL=rediss://default:<password>@<name>.upstash.io:6379
REDIS_URL=redis://localhost:6379/0
# Time limit of one Redis call, in seconds. Raise it (for example to 1) for a Redis that is far away.
REDIS_SOCKET_TIMEOUT_SECONDS=0.5
# How long a search result stays cached, in seconds
CACHE_TTL_SECONDS=3600
# How long the seasons and episodes of a series stay cached, in seconds (title details, US-09)
DETAILS_CACHE_TTL_SECONDS=86400
# Negative cache: how long an empty answer (no search result, or an id that IGDB or TMDB does not
# know) stays cached, in seconds. Keep it short (300 to 600). 0 turns it off.
NEGATIVE_CACHE_TTL_SECONDS=300
# Database cache (L2): a title whose details were loaded less than this many days ago is served from
# PostgreSQL (media_items.last_synced) without a call to IGDB or TMDB. 0 turns it off.
DB_CACHE_TTL_DAYS=7

# Catalog search (US-08) and series details (US-09). Leave a source empty to turn it off: its
# searches (and the seasons of a series) then return 503.
# IGDB (games): create a Twitch application at https://dev.twitch.tv/console and copy the
# Client ID and generate a Client Secret. See https://api-docs.igdb.com
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# TMDB (series and movies): the "API Read Access Token" or the API key from
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=
# Keyless demo mode: IGDB_CLIENT_ID=public (with any value in IGDB_CLIENT_SECRET) uses the Steam Store
# for games. TMDB_API_KEY=public uses TVMaze for series and Wikidata for movies. The ids are then the
# ids of those services, so fill one database in one mode only.
# Calls to IGDB and TMDB: read timeout in seconds, retries for timeouts, 429 and 5xx, and the first
# wait between retries in seconds (it doubles after each retry).
EXTERNAL_API_TIMEOUT_SECONDS=8
EXTERNAL_API_MAX_RETRIES=3
EXTERNAL_API_BACKOFF_SECONDS=0.5
# The most requests per second that this backend process sends to IGDB (IGDB allows 4 and answers
# 429 above that). Every try, a retry too, waits for its turn. 0 turns the limit off. The limit
# counts per process, so give each process its share when the backend runs more than one.
IGDB_MAX_REQUESTS_PER_SECOND=3

# Rate limits (#217). Each one is "<count>/<period>", the period is second, minute, hour or day.
# Login and register count per client address, search, review, details and recommendations per user. Too many calls get
# 429 with a Retry-After header. Counted in Redis, or in the process when Redis is down.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
# Failed logins of one account from any address. Over it, the account cannot log in until the
# window ends (docs/deployment.md, section 9.1)
RATE_LIMIT_LOGIN_ACCOUNT=20/hour
RATE_LIMIT_REGISTER=5/hour
# Registrations of one address in a day, besides the limit per hour (#395)
RATE_LIMIT_REGISTER_DAY=20/day
RATE_LIMIT_SEARCH=30/minute
RATE_LIMIT_REVIEW=20/minute
RATE_LIMIT_DETAILS=60/minute
RATE_LIMIT_RECOMMENDATIONS=30/minute
# All writes of one user to the library, the chapters and the lists, together (#431)
RATE_LIMIT_WRITES=120/minute
# Which address the login and register limits count behind a proxy (#251, #301, see
# docs/deployment.md section 9.1). 0 uses the address that uvicorn gives (development, Docker).
# n > 0 counts the n-th address from the right end of X-Forwarded-For. render.yaml sets 1.
FORWARDED_TRUSTED_HOPS=0
# A key shared with the frontend, at least 32 characters, or empty (off). With it the backend
# trusts the browser address that the frontend sends in X-Client-IP. render.yaml generates it.
FRONTEND_PROXY_SECRET=

# OpenAI integration (embeddings and spoiler detection)
# Leave OPENAI_API_KEY empty to turn the OpenAI calls off. A review is then checked with local
# patterns. With a key, the embedding of a title and the spoiler check of a review run after the
# answer in a background job, so no request waits for OpenAI (#382).
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
SPOILER_MODEL=gpt-4o-mini
SPOILER_THRESHOLD=0.5
# Who checks a review for spoilers. "openai" (default) sends the review text to OpenAI when the key
# is set. "local" keeps all review text inside the system, also when the key is set for embeddings.
SPOILER_PROVIDER=openai
OPENAI_TIMEOUT_SECONDS=8
OPENAI_MAX_RETRIES=2
# After a failed call (no connection, timeout, 429 or 5xx), OpenAI is not called for this many
# seconds. 0 turns the pause off.
OPENAI_COOLDOWN_SECONDS=60
# Threads for the jobs that run after the answer
BACKGROUND_WORKERS=2
