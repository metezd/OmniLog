{
  "name": "Branch names",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": ["~ALL"],
      "exclude": ["~DEFAULT_BRANCH", "refs/heads/dependabot/**"]
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "branch_name_pattern",
      "parameters": {
        "name": "type/short-description",
        "negate": false,
        "operator": "regex",
        "pattern": "^(feat|fix|chore|docs|test)/[a-z0-9][a-z0-9._-]*$"
      }
    }
  ]
}
