# Reverse proxy with automatic HTTPS (Let's Encrypt). The two names come from the .env.prod file.
# The proxy is the only service that is open to the network (ports 80 and 443).

# Browser headers for both sites (#304). HSTS is one year, the same as the API (#394) and the
# frontend (#425); it started with one day on 2026-11-25. The Content-Security-Policy of the app
# comes from the frontend itself (src/proxy.ts, #303), and the API sets its own. No
# includeSubDomains and no preload, the same as the frontend and the API (#449).
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Frame-Options "DENY"
		-Server
	}
}

{$APP_DOMAIN} {
	import security_headers
	encode zstd gzip
	# The frontend sends its own HSTS header for Render (#425). Drop it here, so the browser gets
	# one header only.
	reverse_proxy frontend:3000 {
		header_down -Strict-Transport-Security
	}
}

{$API_DOMAIN} {
	import security_headers
	encode zstd gzip
	# The same limit as the backend (#302). A chunked body has no Content-Length in advance.
	request_body {
		max_size 1MB
	}
	# The API sends its own HSTS header for Render (#394). Drop it here, so the browser gets the
	# one of the security_headers block above only, and never two.
	reverse_proxy backend:8000 {
		header_down -Strict-Transport-Security
	}
}
