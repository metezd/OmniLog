# Copy this file to .env.local for development. Never commit real values.

# The address of the backend. Only the server code of Next.js (Server Components and Server
# Actions) calls the backend, so this is read at run time and the browser never sees it.
# Required in production. In development it defaults to http://localhost:8000.
# It must start with http:// or https://
BACKEND_URL=http://localhost:8000

# Public backend address passed at Docker build time (see frontend/Dockerfile).
NEXT_PUBLIC_API_URL=http://localhost:8000
