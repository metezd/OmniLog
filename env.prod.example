# Settings of the production stack. Copy this file to .env.prod and fill in every value.
# .env.prod holds secrets. Never commit it.
#   cp env.prod.example .env.prod

# Passwords. Use long random values made of letters and digits, for example:  openssl rand -hex 32
# (Do not use base64. Characters such as / or + would break the database and Redis addresses.)
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Signs the login tokens. At least 32 characters. For example:  openssl rand -hex 32
SECRET_KEY=

# Two names that point to this server (DNS A records). The proxy gets a certificate for each.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# The browser never calls the backend: the server code of the frontend calls it at
# http://backend:8000, which the compose file sets. So no public API address is needed here.

# The address of the frontend. The backend accepts browser calls only from here.
CORS_ORIGINS=https://app.example.com

# Optional. The API documentation (/docs, /redoc, /openapi.json) is off in production.
# Set to true only for a short check, then turn it off again.
# ENABLE_DOCS=false

# Optional values. The catalog search needs these keys.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
TMDB_API_KEY=

# Optional. Rate limits (#217): "<count>/<second|minute|hour|day>". The values below are the
# defaults. Login and register count per browser address, search and review per user.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_LOGIN=10/minute
# RATE_LIMIT_LOGIN_ACCOUNT=20/hour
# RATE_LIMIT_REGISTER=5/hour
# RATE_LIMIT_REGISTER_DAY=20/day
# RATE_LIMIT_SEARCH=30/minute
# RATE_LIMIT_REVIEW=20/minute
# RATE_LIMIT_DETAILS=60/minute
# RATE_LIMIT_RECOMMENDATIONS=30/minute

# Optional. How long a login token stays valid, in minutes.
# ACCESS_TOKEN_EXPIRE_MINUTES=90

# Optional. Caches (docs/deployment.md, section 4). The values below are the defaults.
# REDIS_SOCKET_TIMEOUT_SECONDS=0.5
# CACHE_TTL_SECONDS=3600
# DETAILS_CACHE_TTL_SECONDS=86400
# NEGATIVE_CACHE_TTL_SECONDS=300
# DB_CACHE_TTL_DAYS=7

# Optional. Calls to IGDB and TMDB: timeout, retries, first wait between retries, and the most
# requests per second to IGDB (0 turns the limit off). The values below are the defaults.
# EXTERNAL_API_TIMEOUT_SECONDS=8
# EXTERNAL_API_MAX_RETRIES=3
# EXTERNAL_API_BACKOFF_SECONDS=0.5
# IGDB_MAX_REQUESTS_PER_SECOND=3

# Optional. The tag of the built images (default: latest)
# TAG=
# OpenAI integration (embeddings and spoiler detection)
# Leave empty to disable OpenAI-backed features.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
SPOILER_MODEL=gpt-4o-mini
SPOILER_THRESHOLD=0.5
# "local" keeps review text inside the system even with OPENAI_API_KEY set (docs/deployment.md, section 4.1)
# SPOILER_PROVIDER=openai
OPENAI_TIMEOUT_SECONDS=8
OPENAI_MAX_RETRIES=2
# OPENAI_COOLDOWN_SECONDS=60
# BACKGROUND_WORKERS=2
