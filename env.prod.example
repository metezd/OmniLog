# Settings of the production stack. Copy this file to .env.prod and fill in every value.
# .env.prod holds secrets. Never commit it.
#   cp env.prod.example .env.prod

# Passwords. Use long random values made of letters and digits, for example:  openssl rand -hex 32
# (Do not use base64. Characters such as / or + would break the database and Redis addresses.)
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Signs the login tokens. At least 32 characters. For example:  openssl rand -hex 32
SECRET_KEY=

# Two names that point to this server (DNS A records). The proxy gets a certificate for each.
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com

# The browser calls the API at this address. It is built into the frontend image,
# so build the images again after you change it.
API_URL=https://api.example.com

# The address of the frontend. The backend accepts browser calls only from here.
CORS_ORIGINS=https://app.example.com

# Optional values. The catalog search needs these keys.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
TMDB_API_KEY=

# Optional. The tag of the built images (default: latest)
# TAG=
