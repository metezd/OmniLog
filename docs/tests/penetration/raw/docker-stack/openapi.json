{"openapi": "3.1.0", "info": {"title": "OmniLog API", "description": "Video Game & TV Series Tracking API", "version": "0.8.0"}, "paths": {"/auth/register": {"post": {"tags": ["auth"], "summary": "Register", "operationId": "register_auth_register_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserCreate"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/auth/login": {"post": {"tags": ["auth"], "summary": "Login", "description": "Log in with a username or an email in the field `username`.", "operationId": "login_auth_login_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserLogin"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Token"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/auth/me": {"get": {"tags": ["auth"], "summary": "Read Current User", "description": "The logged in user. The token holds only the id, so clients call this to show who is logged in.", "operationId": "read_current_user_auth_me_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserResponse"}}}}}, "security": [{"HTTPBearer": []}]}}, "/media": {"post": {"tags": ["Media"], "summary": "Create Media", "description": "Create a new media item in the catalog. Off by default, see ALLOW_MEDIA_CREATE.", "operationId": "create_media_media_post", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/MediaItemCreate"}}}, "required": true}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MediaItemResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}, "security": [{"HTTPBearer": []}]}}, "/media/{media_id}": {"get": {"tags": ["Media"], "summary": "Get Media", "description": "Fetch a single media item by ID. Needs a login, like every other catalog endpoint.", "operationId": "get_media_media__media_id__get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "media_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Media Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MediaItemResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/catalog/search": {"get": {"tags": ["Catalog"], "summary": "Search Catalog", "description": "Search games (IGDB) or series and movies (TMDB) by title.\n\nEach result is saved in the catalog and has an `id`, so it can be added to the library with\n`POST /library`. A search with no match returns an empty list. When the outside service is\ndown, saved titles that match are returned, or 503 when there are none.", "operationId": "search_catalog_catalog_search_get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "q", "in": "query", "required": true, "schema": {"type": "string", "minLength": 1, "maxLength": 100, "description": "Title to search for", "title": "Q"}, "description": "Title to search for"}, {"name": "type", "in": "query", "required": true, "schema": {"$ref": "#/components/schemas/MediaType", "description": "GAME, SERIES or MOVIE"}, "description": "GAME, SERIES or MOVIE"}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/MediaItemResponse"}, "title": "Response Search Catalog Catalog Search Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/catalog/{media_id}": {"get": {"tags": ["Catalog"], "summary": "Get Title Details", "description": "Open a title: its metadata and artwork, and its seasons with episodes or its chapters.\n\nA series gets its seasons and episodes from TMDB the first time it is opened. They are saved\nand cached, so later requests do not call TMDB again. The chapters of a game have no outside\nsource, so they come from the database only. A movie has neither. When TMDB is down, the saved\ncopy is returned, or 503 when the series was never loaded.", "operationId": "get_title_details_catalog__media_id__get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "media_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Media Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/MediaDetailResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/library": {"post": {"tags": ["Library"], "summary": "Add To Library", "description": "Add a title to the user's library and record a diary event (US-04, US-07).", "operationId": "add_to_library_library_post", "security": [{"HTTPBearer": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserLibraryCreate"}}}}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserLibraryResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "get": {"tags": ["Library"], "summary": "Get Library", "description": "Get the library entries of the logged-in user only, oldest first.\n\n`limit` (1 to 500, default 200) and `offset` (default 0) page the answer. The answer stays a\nplain list. A limit above 500 gives 422.", "operationId": "get_library_library_get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 500, "minimum": 1, "description": "Maximum number of rows to return (1 to 500, default 200).", "default": 200, "title": "Limit"}, "description": "Maximum number of rows to return (1 to 500, default 200)."}, {"name": "offset", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0, "description": "Number of rows to skip (default 0).", "default": 0, "title": "Offset"}, "description": "Number of rows to skip (default 0)."}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/UserLibraryResponse"}, "title": "Response Get Library Library Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/library/{entry_id}": {"patch": {"tags": ["Library"], "summary": "Update Library Entry", "description": "Rate or change the status of an entry (US-05). Changes are recorded in the diary (US-07).", "operationId": "update_library_entry_library__entry_id__patch", "security": [{"HTTPBearer": []}], "parameters": [{"name": "entry_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Entry Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserLibraryUpdate"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/UserLibraryResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "delete": {"tags": ["Library"], "summary": "Remove Library Entry", "description": "Remove a title from the library. The chapter ratings, playtime and decisions of the user for\nthis title are deleted with it, so a client should ask for confirmation first. The removal is\nrecorded in the diary.", "operationId": "remove_library_entry_library__entry_id__delete", "security": [{"HTTPBearer": []}], "parameters": [{"name": "entry_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Entry Id"}}], "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/library/{entry_id}/review": {"post": {"tags": ["Library"], "summary": "Submit Review", "description": "Submit or replace the user's review for a library entry with spoiler detection (US-14).", "operationId": "submit_review_library__entry_id__review_post", "security": [{"HTTPBearer": []}], "parameters": [{"name": "entry_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Entry Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReviewCreate"}}}}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReviewResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "get": {"tags": ["Library"], "summary": "Get Review", "description": "Get the user's review for a library entry, or null when no review has been posted yet.", "operationId": "get_review_library__entry_id__review_get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "entry_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Entry Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"anyOf": [{"$ref": "#/components/schemas/ReviewResponse"}, {"type": "null"}], "title": "Response Get Review Library  Entry Id  Review Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/library/{entry_id}/chapters/{chapter_id}/rating": {"put": {"tags": ["Episodic Logging"], "summary": "Rate Chapter", "description": "Give a chapter or episode of a title in the library a rating from 1 to 5 (US-10).\n\nThe call can be repeated. A new rating replaces the old one. The change is recorded in the\ndiary as CHAPTER_RATED (US-07).", "operationId": "rate_chapter_library__entry_id__chapters__chapter_id__rating_put", "security": [{"HTTPBearer": []}], "parameters": [{"name": "entry_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Entry Id"}}, {"name": "chapter_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Chapter Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterRatingUpdate"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterRatingResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/library/{entry_id}/chapters/{chapter_id}/playtime": {"post": {"tags": ["Episodic Logging"], "summary": "Log Playtime", "description": "Log the minutes spent on a chapter or episode (US-11).\n\nEvery call adds one entry. The total of the chapter is the sum of the entries, so 90 and\nlater 30 minutes make 120. The entry is recorded in the diary as PLAYTIME_LOGGED (US-07).", "operationId": "log_playtime_library__entry_id__chapters__chapter_id__playtime_post", "security": [{"HTTPBearer": []}], "parameters": [{"name": "entry_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Entry Id"}}, {"name": "chapter_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Chapter Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PlaytimeCreate"}}}}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/PlaytimeLogResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/library/{entry_id}/chapters/{chapter_id}/decision": {"put": {"tags": ["Episodic Logging"], "summary": "Record Decision", "description": "Record the option chosen at a decision point of a chapter (US-12).\n\nThe choice is the label of one of the options, such as \"A\". Any other value returns 422 and\nthe message lists the allowed labels. A new choice replaces the old one, so only the latest\nis kept. A chapter with several decision points needs `decision_point_id`. The change is\nrecorded in the diary as DECISION_RECORDED (US-07).", "operationId": "record_decision_library__entry_id__chapters__chapter_id__decision_put", "security": [{"HTTPBearer": []}], "parameters": [{"name": "entry_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Entry Id"}}, {"name": "chapter_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Chapter Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DecisionCreate"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DecisionResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/library/{entry_id}/chapters/{chapter_id}": {"get": {"tags": ["Episodic Logging"], "summary": "Get Chapter Progress", "description": "What the user has recorded for a chapter: the rating, the total playtime and the choices.\n\nA chapter without data returns no rating, 0 minutes and no choice. Reading creates nothing.", "operationId": "get_chapter_progress_library__entry_id__chapters__chapter_id__get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "entry_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Entry Id"}}, {"name": "chapter_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Chapter Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ChapterProgressResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/lists": {"post": {"tags": ["Journal"], "summary": "Create Custom List", "description": "Create a list. The name must be unique for the user.", "operationId": "create_custom_list_lists_post", "security": [{"HTTPBearer": []}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CustomListCreate"}}}}, "responses": {"201": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CustomListResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "get": {"tags": ["Journal"], "summary": "Get Custom Lists", "description": "Get the lists of the logged-in user, oldest first.\n\n`limit` (1 to 500, default 200) and `offset` (default 0) page the answer. The answer stays a\nplain list. A limit above 500 gives 422.", "operationId": "get_custom_lists_lists_get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 500, "minimum": 1, "description": "Maximum number of rows to return (1 to 500, default 200).", "default": 200, "title": "Limit"}, "description": "Maximum number of rows to return (1 to 500, default 200)."}, {"name": "offset", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0, "description": "Number of rows to skip (default 0).", "default": 0, "title": "Offset"}, "description": "Number of rows to skip (default 0)."}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/CustomListResponse"}, "title": "Response Get Custom Lists Lists Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/lists/{list_id}": {"get": {"tags": ["Journal"], "summary": "Get Custom List", "description": "Get one list with its items.", "operationId": "get_custom_list_lists__list_id__get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "list_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "List Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CustomListResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "delete": {"tags": ["Lists"], "summary": "Delete Custom List", "description": "Delete a custom list completely. Recorded in the diary as LIST_DELETED.", "operationId": "delete_custom_list_lists__list_id__delete", "security": [{"HTTPBearer": []}], "parameters": [{"name": "list_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "List Id"}}], "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/lists/{list_id}/items": {"post": {"tags": ["Journal"], "summary": "Add Item To List", "description": "Add a title to a list. 201 when it is added, 200 when it was already in the list.", "operationId": "add_item_to_list_lists__list_id__items_post", "security": [{"HTTPBearer": []}], "parameters": [{"name": "list_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "List Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CustomListItemCreate"}}}}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CustomListItemResponse"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/lists/{list_id}/items/{media_item_id}": {"delete": {"tags": ["Lists"], "summary": "Remove Item From List", "description": "Remove a media item from a custom list. Recorded in the diary as LIST_ITEM_REMOVED.", "operationId": "remove_item_from_list_lists__list_id__items__media_item_id__delete", "security": [{"HTTPBearer": []}], "parameters": [{"name": "list_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "List Id"}}, {"name": "media_item_id", "in": "path", "required": true, "schema": {"type": "integer", "title": "Media Item Id"}}], "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/diary": {"get": {"tags": ["Journal"], "summary": "Get Activity Diary", "description": "Get the activity events of the logged-in user, newest first.\n\n`limit` (1 to 500, default 100) and `offset` (default 0) page the answer. The answer stays a\nplain list. A limit above 500 gives 422. To read the next page, add the number of rows you\ngot to the `offset`.", "operationId": "get_activity_diary_diary_get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 500, "minimum": 1, "description": "Maximum number of rows to return (1 to 500, default 100).", "default": 100, "title": "Limit"}, "description": "Maximum number of rows to return (1 to 500, default 100)."}, {"name": "offset", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 0, "description": "Number of rows to skip (default 0).", "default": 0, "title": "Offset"}, "description": "Number of rows to skip (default 0)."}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/DiaryEntryResponse"}, "title": "Response Get Activity Diary Diary Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/recommendations": {"get": {"tags": ["Recommendations"], "summary": "Get Recommendations", "description": "Recommend unowned titles of the requested media type.", "operationId": "get_recommendations_recommendations_get", "security": [{"HTTPBearer": []}], "parameters": [{"name": "target", "in": "query", "required": true, "schema": {"$ref": "#/components/schemas/MediaType"}}, {"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 50, "minimum": 1, "default": 10, "title": "Limit"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/MediaItemResponse"}, "title": "Response Get Recommendations Recommendations Get"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/stats": {"get": {"tags": ["Statistics"], "summary": "Get Stats", "description": "Media split, rating distribution, genre breakdown and playtime of the user's library.", "operationId": "get_stats_stats_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/StatsResponse"}}}}}, "security": [{"HTTPBearer": []}]}}, "/": {"get": {"summary": "Read Root", "operationId": "read_root__get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}}}}, "/health": {"get": {"summary": "Health Check", "description": "Liveness: the process answers. Use this for the health check of the host (Docker, Render).", "operationId": "health_check_health_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}}}}, "/health/ready": {"get": {"summary": "Readiness Check", "description": "Readiness: the parts that the API needs. Use this for an uptime monitor, not for restarts.\n\nThe database is required. Redis is optional, because the API works without it (NFR-04), so\nRedis down only shows as \"down\" and the answer stays 200. No error details are returned.", "operationId": "readiness_check_health_ready_get", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {}}}}}}}}, "components": {"schemas": {"ChapterKind": {"type": "string", "enum": ["EPISODE", "CHAPTER"], "title": "ChapterKind"}, "ChapterProgressResponse": {"properties": {"library_entry_id": {"type": "integer", "title": "Library Entry Id"}, "chapter_id": {"type": "integer", "title": "Chapter Id"}, "rating": {"anyOf": [{"type": "integer"}, {"type": 