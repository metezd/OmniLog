@startuml 01-domain-model
title OmniLog - Domain Model (backend/app/models/entities.py)
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam classAttributeIconSize 0
hide empty methods

enum MediaType {
  GAME
  SERIES
  MOVIE
}
enum WatchStatus {
  PLAN_TO_WATCH
  IN_PROGRESS
  COMPLETED
  DROPPED
}
enum ChapterKind {
  EPISODE
  CHAPTER
}

class User <<users>> {
  +id : int <<PK>>
  +username : str <<unique, chk_username_no_at>>
  +email : str <<unique>>
  +hashed_password : str
  +created_at : datetime
}

class Genre <<genres>> {
  +id : int <<PK>>
  +name : str <<unique>>
}

class media_item_genres <<Table>> {
  +media_item_id : int <<PK, FK>>
  +genre_id : int <<PK, FK>>
}

class MediaItem <<media_items>> {
  +id : int <<PK>>
  +title : str
  +media_type : MediaType
  +poster_url : str
  +release_date : str
  +description : str
  +external_api_id : int
  +last_synced : datetime
}

class UserLibrary <<user_libraries>> {
  +id : int <<PK>>
  +user_id : int <<FK>>
  +media_item_id : int <<FK>>
  +status : WatchStatus
  +rating : float <<1..10>>
  +updated_at : datetime
}

class Review <<reviews>> {
  +id : int <<PK>>
  +library_entry_id : int <<FK, unique>>
  +text : str
  +contains_spoiler : bool
  +spoiler_score : float
  +spoiler_model_version : str
  +created_at : datetime
  +updated_at : datetime
}

class CustomList <<custom_lists>> {
  +id : int <<PK>>
  +user_id : int <<FK>>
  +name : str <<uq_user_list_name>>
  +created_at : datetime
}

class CustomListItem <<custom_list_items>> {
  +id : int <<PK>>
  +list_id : int <<FK>>
  +media_item_id : int <<FK>>
  +added_at : datetime
}

class DiaryEntry <<diary_entries>> {
  +id : int <<PK>>
  +user_id : int <<FK>>
  +media_item_id : int <<FK, nullable>>
  +action : str
  +details : str
  +created_at : datetime
}

class Season <<seasons>> {
  +id : int <<PK>>
  +media_item_id : int <<FK>>
  +season_number : int
  +title : str
  +air_date : str
}

class Chapter <<chapters>> {
  +id : int <<PK>>
  +media_item_id : int <<FK>>
  +season_id : int <<FK, nullable>>
  +number : int
  +kind : ChapterKind
  +title : str
  +release_date : str
  +runtime_minutes : int
  +external_id : int
}

class ChapterProgress <<chapter_progress>> {
  +id : int <<PK>>
  +library_entry_id : int <<FK>>
  +chapter_id : int <<FK>>
  +media_item_id : int <<FK>>
  +rating : int <<1..5>>
  +playtime_minutes : int <<>= 0>>
  +updated_at : datetime
}

class PlaytimeLog <<playtime_logs>> {
  +id : int <<PK>>
  +chapter_progress_id : int <<FK>>
  +minutes : int <<>= 1>>
  +logged_at : datetime
}

class DecisionPoint <<decision_points>> {
  +id : int <<PK>>
  +chapter_id : int <<FK>>
  +media_item_id : int <<FK>>
  +prompt : str
  +position : int <<>= 1>>
}

class DecisionOption <<decision_options>> {
  +id : int <<PK>>
  +decision_point_id : int <<FK>>
  +label : str
  +text : str
}

class UserDecision <<user_decisions>> {
  +id : int <<PK>>
  +library_entry_id : int <<FK>>
  +decision_point_id : int <<FK>>
  +option_id : int <<FK>>
  +media_item_id : int <<FK>>
  +decided_at : datetime
}

User "1" *-- "0..*" UserLibrary : library_entries
User "1" *-- "0..*" CustomList : custom_lists
User "1" *-- "0..*" DiaryEntry : diary_entries
MediaItem "1" o-- "0..*" UserLibrary : library_entries
MediaItem "0..*" -- "0..*" Genre : genres (via media_item_genres)
MediaItem .. media_item_genres
Genre .. media_item_genres
MediaItem "1" *-- "0..*" Season : seasons
MediaItem "1" *-- "0..*" Chapter : chapters
Season "1" *-- "0..*" Chapter : episodes
CustomList "1" *-- "0..*" CustomListItem : items
MediaItem "1" o-- "0..*" CustomListItem : list_items
DiaryEntry "0..*" --> "0..1" MediaItem : media_item
UserLibrary "1" *-- "0..1" Review : review
UserLibrary "1" *-- "0..*" ChapterProgress : chapter_progress
Chapter "1" *-- "0..*" ChapterProgress : progress_entries
ChapterProgress "1" *-- "0..*" PlaytimeLog : playtime_logs
Chapter "1" *-- "0..*" DecisionPoint : decision_points
DecisionPoint "1" *-- "0..*" DecisionOption : options
UserLibrary "1" *-- "0..*" UserDecision
DecisionPoint "1" -- "0..*" UserDecision
DecisionOption "1" -- "0..*" UserDecision

MediaItem ..> MediaType
UserLibrary ..> WatchStatus
Chapter ..> ChapterKind

note bottom of ChapterProgress
  Composite foreign keys (id, media_item_id) on UserLibrary, Chapter
  and DecisionPoint guarantee that ChapterProgress and UserDecision
  always join records of the same MediaItem (BR-11).
end note
@enduml
