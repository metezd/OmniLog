classDiagram
  class MediaType {
    <<enumeration>>
    GAME
    SERIES
    MOVIE
  }

  class WatchStatus {
    <<enumeration>>
    PLAN_TO_WATCH
    IN_PROGRESS
    COMPLETED
    DROPPED
  }

  class ChapterKind {
    <<enumeration>>
    EPISODE
    CHAPTER
  }

  class User {
    +int id
    +str username
    +str email
    +str hashed_password
    +datetime created_at
  }

  class Genre {
    +int id
    +str name
  }

  class media_item_genres {
    <<Table>>
    +int media_item_id
    +int genre_id
  }

  class MediaItem {
    +int id
    +str title
    +MediaType media_type
    +str poster_url
    +str release_date
    +str description
    +int external_api_id
    +datetime last_synced
  }

  class Season {
    +int id
    +int media_item_id
    +int season_number
    +str title
    +str air_date
  }

  class Chapter {
    +int id
    +int media_item_id
    +int season_id
    +int number
    +ChapterKind kind
    +str title
    +str release_date
    +int runtime_minutes
    +int external_id
  }

  class DecisionPoint {
    +int id
    +int chapter_id
    +int media_item_id
    +str prompt
    +int position
  }

  class DecisionOption {
    +int id
    +int decision_point_id
    +str label
    +str text
  }

  class UserLibrary {
    +int id
    +int user_id
    +int media_item_id
    +WatchStatus status
    +float rating
    +datetime updated_at
  }

  class ChapterProgress {
    +int id
    +int library_entry_id
    +int chapter_id
    +int media_item_id
    +int rating
    +int playtime_minutes
    +datetime updated_at
  }

  class PlaytimeLog {
    +int id
    +int chapter_progress_id
    +int minutes
    +datetime logged_at
  }

  class UserDecision {
    +int id
    +int library_entry_id
    +int decision_point_id
    +int option_id
    +int media_item_id
    +datetime decided_at
  }

  class Review {
    +int id
    +int library_entry_id
    +str text
    +bool contains_spoiler
    +float spoiler_score
    +str spoiler_model_version
    +datetime created_at
    +datetime updated_at
  }

  class CustomList {
    +int id
    +int user_id
    +str name
    +datetime created_at
  }

  class CustomListItem {
    +int id
    +int list_id
    +int media_item_id
    +datetime added_at
  }

  class DiaryEntry {
    +int id
    +int user_id
    +int media_item_id
    +str action
    +str details
    +datetime created_at
  }

  User "1" --> "*" UserLibrary : library_entries
  User "1" --> "*" CustomList : custom_lists
  User "1" --> "*" DiaryEntry : diary_entries
  MediaItem "*" -- "*" Genre : genres (media_item_genres)
  MediaItem "1" --> "*" Season : seasons
  MediaItem "1" --> "*" Chapter : chapters
  Season "1" --> "*" Chapter : episodes
  Chapter "1" --> "*" DecisionPoint : decision_points
  DecisionPoint "1" --> "*" DecisionOption : options
  UserLibrary "*" --> "1" MediaItem : media_item
  UserLibrary "1" --> "*" ChapterProgress : chapter_progress
  UserLibrary "1" --> "0..1" Review : review
  UserLibrary "1" --> "*" UserDecision : decisions
  ChapterProgress "*" --> "1" Chapter : chapter
  ChapterProgress "1" --> "*" PlaytimeLog : playtime_logs
  UserDecision "*" --> "1" DecisionPoint : decision_point
  UserDecision "*" --> "1" DecisionOption : option
  CustomList "1" --> "*" CustomListItem : items
  CustomListItem "*" --> "1" MediaItem : media_item
  DiaryEntry "*" --> "0..1" MediaItem : media_item
